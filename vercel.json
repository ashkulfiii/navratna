{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/product/:handle", "destination": "/product/index.html" }
  ],
  "redirects": [
    { "source": "/products/:handle", "destination": "/product/:handle", "permanent": true },
    { "source": "/collections/:path*", "destination": "/shop", "permanent": true },
    { "source": "/pages/about", "destination": "/about", "permanent": true },
    { "source": "/pages/contact", "destination": "/contact", "permanent": true },
    { "source": "/policies/privacy-policy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/policies/terms-of-service", "destination": "/terms-conditions", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
